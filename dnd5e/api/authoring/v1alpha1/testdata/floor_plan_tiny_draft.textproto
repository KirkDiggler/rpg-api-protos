# Structurally valid validate-only draft projection. A current provider still
# resolves the source and projects cells while entrance remains absent because no
# PartyCap anchor qualifies.
width: 3
height: 3
floor_source: FLOOR_PLAN_FLOOR_SOURCE_REGIONS
floor_cells: { column: 1 row: 1 }
floor_cells: { column: 1 row: 2 }
edges: {
  from: { column: 1 row: 1 }
  to: { column: 0 row: 1 }
  kind: FLOOR_PLAN_EDGE_KIND_SOLID
}
